{
  "expo": {
    "name": "Ignova",
    "slug": "wildfire-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wildfiremonitor",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lithos.wildfiremonitor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E11"
      },
      "package": "com.lithos.wildfiremonitor",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ignova uses your location to show wildfire activity near you."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22a92e91-d3bb-49d9-aae8-7553e578cd1d"
      }
    }
  }
}
